# ==============================================================================
# GESTOR DE NOTAS MOBILE — VARIABLES DE ENTORNO (FLUTTER)
# ==============================================================================
# Copia este archivo a `.env` dentro de la carpeta `mobile/`

# Para Emulador Android (10.0.2.2 es el alias reservado que mapea al localhost de tu PC):
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Para Dispositivo Físico (mismo WiFi que tu PC):
# API_BASE_URL=http://192.168.1.35:8000/api/v1

# Para Web / Simulador iOS:
# API_BASE_URL=http://localhost:8000/api/v1
