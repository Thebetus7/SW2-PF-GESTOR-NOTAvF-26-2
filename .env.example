# ==============================================================================
# GESTOR DE NOTAS & EVALUACIONES CON IA — VARIABLES DE ENTORNO GLOBALES (DOCKER)
# ==============================================================================
# Copia este archivo a `.env` en la raíz antes de ejecutar `docker compose up`

# PostgreSQL
POSTGRES_DB=gestornotas_db
POSTGRES_USER=gestornotas_user
POSTGRES_PASSWORD=gestornotas_secure_pass_2026
POSTGRES_PORT=5432

# Django Backend
DJANGO_SECRET_KEY=django-insecure-change-in-production-random-hash-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# Google Gemini API (Free Tier v1beta)
# Obtén tu API Key gratuita en https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Frontend Web Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
