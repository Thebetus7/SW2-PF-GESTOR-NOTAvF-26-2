# ==============================================================================
# CONFIGURACIÓN ESPECÍFICA DEL BACKEND (DJANGO REST FRAMEWORK)
# ==============================================================================
# Copia este archivo a `.env` dentro de la carpeta `backend/` antes de ejecutar.

DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# Base de Datos:
# Establece USE_SQLITE=True para desarrollo local rápido sin necesidad de Docker/PostgreSQL.
# Establece USE_SQLITE=False si usas PostgreSQL nativo o mediante Docker.
USE_SQLITE=True

# Configuración de PostgreSQL (solo si USE_SQLITE=False)
POSTGRES_DB=gestornotas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (Orígenes autorizados para Next.js y clientes Web)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Free Tier (Obtén tu API Key gratuita en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui
